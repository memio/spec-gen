{
    "name": "memio/spec-gen",
    "license": "MIT",
    "type": "library",
    "description": "phpspec extension for better code generation",
    "keywords": ["phpspec", "extension", "generator", "PHP", "code"],
    "homepage": "http://memio.github.io/spec-gen",
    "authors": [
        {
            "name": "Loïc Faugeron",
            "email": "faugeron.loic@gmail.com",
            "homepage": "http://gnugat.github.io",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Memio\\SpecGen\\": "src/Memio/SpecGen"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Memio\\SpecGen\\Fixtures\\": "fixtures",
            "tests\\Memio\\SpecGen\\": "tests/Memio/SpecGen"
        }
    },
    "require": {
        "gnugat/redaktilo": "^2.0",
        "memio/memio": "^3.0",
        "memio/linter": "^3.0",
        "memio/validator": "^3.0",
        "memio/model": "^3.0",
        "memio/pretty-printer": "^3.0",
        "memio/twig-template-engine": "^3.0",
        "php": "^8.0",
        "phpspec/phpspec": "^6.3",
        "symfony/event-dispatcher": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.19.3",
        "phpstan/phpstan": "1.12.32",
        "phpunit/phpunit": "^8.4",
        "rector/rector": "^1.2.10",
        "rector/swiss-knife": "^2.3"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    }
}
